{
  "name": "leav-server",
  "version": "1.0.0",
  "private": true,
  "description": "Leave management system API (Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch",
    "db:setup": "node scripts/setupDb.js",
    "db:seed": "node scripts/seedDb.js",
    "db:reset": "node scripts/resetDb.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}