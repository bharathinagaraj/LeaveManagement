# ---- Server environment ----
# Port the Express API listens on
PORT=5000

# PostgreSQL connection string (db:setup creates the "leav" database if missing)
DATABASE_URL=postgres://postgres:Welcome%40123@localhost:5432/leav



# Used to sign JWTs. Change in production!
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime, e.g. 1h, 7d, 30d
JWT_EXPIRES_IN=7d